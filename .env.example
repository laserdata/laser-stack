# Tested component versions.
LASER_IGGY_VERSION=0.8.104-ld
LASER_PLANE_VERSION=0.14.0
# The published SDK the managed smoke installs and runs against the stack.
LASER_SDK_VERSION=0.1.0

# Runtime images.
LASER_IGGY_IMAGE=docker.io/laserdatainc/iggy-server:latest
LASER_PLANE_IMAGE=docker.io/laserdatainc/laser-plane:latest

# Optional Iggy build optimization for amd64.
LASER_IGGY_CPU=skylake

# Local access.
LASER_BIND_ADDRESS=127.0.0.1
LASER_IGGY_PORT=8090
LASER_IGGY_HTTP_PORT=3000
LASER_IGGY_USERNAME=iggy
LASER_IGGY_PASSWORD=laser

LASER_SMOKE_NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
LASER_START_TIMEOUT=120
LASER_SMOKE_TIMEOUT=300
